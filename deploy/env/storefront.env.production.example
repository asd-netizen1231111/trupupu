# =============================================================================
# Storefront (Next.js 16) — шаблон production-окружения для dobrayahata.by
# =============================================================================
# Только плейсхолдеры. Реальные значения вписывать НА СЕРВЕРЕ, в файл
#   apps/storefront/.env.production
# (Next.js читает его при `next build` и `next start`; в git не кладём).
#
# !!! ВАЖНО: все NEXT_PUBLIC_* ВШИВАЮТСЯ В СБОРКУ (`npm run build`) !!!
# Их нужно задать ДО сборки. Изменили значение — пересоберите витрину
# (`next build`), одного `pm2 restart` недостаточно.
# Переменные без NEXT_PUBLIC_ читаются при старте (runtime).
#
# Обозначения:
#   [BUILD]    — NEXT_PUBLIC_*, вшивается при `next build`
#   [runtime]  — читается при старте процесса
# Формат: KEY=value, без пробелов вокруг "=", без кавычек.
# =============================================================================

# [runtime + build] Режим. next build/start и так ставят production, но
# явное значение не мешает (включает secure-cookie в lib/data/cookies.ts).
NODE_ENV=production

# [BUILD] Публичный URL API Medusa. Используется и браузером, и сервером витрины;
# из его хоста строится images.remotePatterns в next.config.js (фото /static/**).
# Только https, без хвостового "/".
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.dobrayahata.by

# [BUILD] Publishable API key магазина. Взять в админке ПРОД-БД:
# https://api.dobrayahata.by/app -> Settings -> Publishable API Keys
# (ключ должен быть привязан к нужному Sales Channel). Вид: pk_xxxxxxxx...
# Это не секрет (виден в браузере), но у каждой БД он свой — ключ из dev-БД
# после переноса дампа тоже подойдёт, если ключ лежит в дампе.
# check-env-variables.js не даст собрать витрину без него.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME

# [BUILD] Публичный URL витрины (canonical, sitemap, Open Graph, абсолютные
# ссылки). Без хвостового "/". Без неё fallback https://localhost:8000.
NEXT_PUBLIC_BASE_URL=https://dobrayahata.by

# [BUILD] Код региона по умолчанию (страна/URL-префикс, редиректы middleware).
# Для магазина — by.
NEXT_PUBLIC_DEFAULT_REGION=by

# [runtime] Секрет, которым бэкенд подтверждает запрос на ревалидацию кэша
# (src/app/api/revalidate/route.ts). ДОЛЖЕН совпадать с REVALIDATE_SECRET бэкенда.
# Взять: bash deploy/gen-secrets.sh. Без префикса NEXT_PUBLIC_ — в браузер не попадает.
REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET

# -----------------------------------------------------------------------------
# Необязательные (по умолчанию не нужны)
# -----------------------------------------------------------------------------
# [BUILD] Разрешить картинки с S3/Medusa Cloud (next.config.js). Не используем:
# фото отдаёт сам бэкенд с /static. Оставить закомментированными.
# MEDUSA_CLOUD_S3_HOSTNAME=
# MEDUSA_CLOUD_S3_PATHNAME=

# -----------------------------------------------------------------------------
# НЕ ЗАДАВАТЬ: NEXT_PUBLIC_STRIPE_KEY, NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY,
# NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID — остатки стартера, оплата через
# pp_system_default. Без ключей Stripe просто выключен.
# -----------------------------------------------------------------------------
