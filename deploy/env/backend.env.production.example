# =============================================================================
# Backend (Medusa 2.22) — шаблон production-окружения для dobrayahata.by
# =============================================================================
# Только плейсхолдеры. Реальные значения вписывать НА СЕРВЕРЕ, в файл
#   apps/backend/.env            (и копия в apps/backend/.medusa/server/.env,
#                                 откуда запускается `medusa start`)
# Файл с реальными значениями в git не кладём (.env игнорируется).
# Секреты сгенерировать: bash deploy/gen-secrets.sh
#
# Обозначения:
#   [runtime]  — читается при старте процесса (pm2 restart достаточно)
#   [build]    — вшивается при `medusa build`; менять -> пересобрать
# Формат: KEY=value, без пробелов вокруг "=", без кавычек (если нет пробелов).
# =============================================================================

# [runtime] Режим. Обязательно production: включает secure-cookie и проверки.
# Medusa также подхватит .env.production, если он есть (он приоритетнее .env).
NODE_ENV=production

# [runtime] Порт HTTP-сервера Medusa (nginx проксирует api.dobrayahata.by на него).
# По умолчанию 9000, можно не задавать.
PORT=9000

# [runtime] Строка подключения к Postgres на этом же сервере.
# Формат: postgres://USER:PASSWORD@127.0.0.1:5432/DBNAME
# Пароль — из gen-secrets.sh (только hex, экранировать в URL не нужно).
# Хост 127.0.0.1/localhost => SSL выключен автоматически (так и надо для
# локального Postgres). Для внешней БД добавьте ?sslmode=require.
# БД и пользователь создаются в промте про Postgres (имя БД: medusa-backend).
DATABASE_URL=postgres://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/medusa-backend

# [runtime] Секрет подписи JWT (админ и покупатели). Минимум 32 символа.
# Взять: gen-secrets.sh (JWT_SECRET). Смена => все сессии слетят.
JWT_SECRET=CHANGE_ME_JWT_SECRET

# [runtime] Секрет подписи cookie сессий. Взять: gen-secrets.sh (COOKIE_SECRET).
# Должен отличаться от JWT_SECRET.
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET

# [runtime] CORS для Store API: с каких origin витрина ходит в бэкенд из браузера.
# Через запятую, без хвостового "/". Без localhost и без docs.medusajs.com.
STORE_CORS=https://dobrayahata.by,https://www.dobrayahata.by

# [runtime] CORS для Admin API: origin админки (/app отдаётся с api-домена).
ADMIN_CORS=https://api.dobrayahata.by

# [runtime] CORS для /auth: админка + витрина (логин/регистрация покупателей).
AUTH_CORS=https://api.dobrayahata.by,https://dobrayahata.by,https://www.dobrayahata.by

# [runtime] Публичный адрес витрины. Бэкенд шлёт на него запрос ревалидации кэша
# (src/lib/revalidate-storefront.ts, subscribers/revalidate-storefront.ts).
# Без переменной по умолчанию http://localhost:8000 — ревалидация не сработает.
STOREFRONT_URL=https://dobrayahata.by

# [runtime] Общий секрет ревалидации кэша. ДОЛЖЕН совпадать с REVALIDATE_SECRET
# в окружении витрины. Взять: gen-secrets.sh (REVALIDATE_SECRET).
REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET

# [runtime] Публичный URL бэкенда. Из него строится адрес загружаемых файлов:
# в БД пишется <BACKEND_PUBLIC_URL>/static/<файл> (medusa-config.ts, file-local).
# ОБЯЗАТЕЛЬНО в production: без неё бэкенд не стартует. Без хвостового "/".
BACKEND_PUBLIC_URL=https://api.dobrayahata.by

# [build] URL API, вшиваемый в админку /app при `medusa build`
# (admin.backendUrl). Задать ДО сборки. Без неё админка ходит на "/" (тот же
# origin) — на нашей схеме тоже работает, но лучше явно.
MEDUSA_BACKEND_URL=https://api.dobrayahata.by

# -----------------------------------------------------------------------------
# НЕ ЗАДАВАТЬ (по итогам аудита, промт 1):
#   REDIS_URL — код его не использует (in-memory event bus/locking, один
#   процесс pm2 в режиме fork). Если позже добавится Redis-модуль — вернуть.
#   DB_NAME, STRIPE_*, поисковые ключи — не читаются кодом.
# -----------------------------------------------------------------------------
